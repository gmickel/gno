{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "status": {
      "type": "string",
      "enum": ["current", "stale", "conflict", "unverifiable"]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "capsuleId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": ["schemaVersion", "status", "reasons", "digest", "capsuleId"],
  "additionalProperties": false
}
