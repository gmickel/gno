          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "byteBudget": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "requiredSets": {
          "type": "array",
          "items": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/definitions/__schema1"
