      "additionalProperties": false
    },
    "__schema1": {
      "type": "string",
      "minLength": 1
    },
    "__schema2": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/__schema1"
