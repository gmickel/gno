    "documents": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/definitions/__schema0"
      }
    },
    "spans": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/definitions/__schema3"
      }
    },
    "cases": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/definitions/__schema4"
      }
    }
