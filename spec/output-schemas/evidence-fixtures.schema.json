        },
        "sourceHash": {
          "$ref": "#/definitions/__schema2"
        },
        "startLine": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "endLine": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "spanHash": {
          "$ref": "#/definitions/__schema2"
        }
      },
      "required": [
        "id",
        "uri",
        "sourceHash",
        "startLine",
        "endLine",
        "spanHash"
      ],
      "additionalProperties": false
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "caseId": {
          "$ref": "#/definitions/__schema1"
        },
        "family": {
          "$ref": "#/definitions/__schema1"
        },
        "query": {
          "$ref": "#/definitions/__schema1"
        },
        "intent": {
          "anyOf": [
            {
              "$ref": "#/definitions/__schema1"
